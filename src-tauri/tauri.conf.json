{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ePerso EPHEC",
  "version": "0.1.0",
  "identifier": "be.ephec.eperso.wrapper",
  "build": {
    "beforeBuildCommand": "if not exist dist mkdir dist && copy index.html dist\\index.html",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
